diff --git a/bench/bench_c.c b/bench/bench_c.c
new file mode 100644
index 0000000..b63c0eb
--- /dev/null
+++ b/bench/bench_c.c
@@ -0,0 +1,101 @@
+/*
+ * Benchmark for the C implementation (Src/Ppm_edge.c).
+ * Measures per-call latency of ppm_process() using CLOCK_MONOTONIC,
+ * reports percentiles. Also used, invoked repeatedly from a shell loop,
+ * to measure process-level cold-start (see bench/run_benchmarks.sh).
+ *
+ * Usage: ./bench_c <iterations> <warmup> <seed>
+ * Output: JSON on stdout.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include "../Src/Ppm_edge.h"
+
+static long long now_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+static int cmp_ll(const void *a, const void *b) {
+    long long la = *(const long long *)a;
+    long long lb = *(const long long *)b;
+    return (la > lb) - (la < lb);
+}
+
+int main(int argc, char **argv) {
+    long iterations = argc > 1 ? atol(argv[1]) : 100000;
+    long warmup = argc > 2 ? atol(argv[2]) : 5000;
+    unsigned int seed = argc > 3 ? (unsigned int)atol(argv[3]) : 123;
+
+    srand(seed);
+
+    ppm_runtime_t rt;
+    ppm_init(&rt, 0, 0);
+
+    long long *samples = malloc(sizeof(long long) * (size_t)iterations);
+    if (!samples) {
+        fprintf(stderr, "allocation failure\n");
+        return 1;
+    }
+
+    for (long i = 0; i < warmup; i++) {
+        ppm_input_t in = {
+            .signal = rand() % 2000001 - 1000000,
+            .baseline = 0,
+            .threshold = rand() % 100001,
+            .confidence = 0,
+            .priority = (ppm_priority_t)(rand() % 4)
+        };
+        ppm_output_t out;
+        ppm_process(&rt, &in, &out);
+    }
+
+    for (long i = 0; i < iterations; i++) {
+        ppm_input_t in = {
+            .signal = rand() % 2000001 - 1000000,
+            .baseline = 0,
+            .threshold = rand() % 100001,
+            .confidence = 0,
+            .priority = (ppm_priority_t)(rand() % 4)
+        };
+        ppm_output_t out;
+        long long t0 = now_ns();
+        ppm_process(&rt, &in, &out);
+        long long t1 = now_ns();
+        samples[i] = t1 - t0;
+    }
+
+    qsort(samples, (size_t)iterations, sizeof(long long), cmp_ll);
+
+    long long sum = 0;
+    for (long i = 0; i < iterations; i++) sum += samples[i];
+
+    long p50 = samples[(size_t)(iterations * 0.50)];
+    long p95 = samples[(size_t)(iterations * 0.95)];
+    long p99 = samples[(size_t)(iterations * 0.99)];
+    long p999 = samples[(size_t)(iterations * (iterations > 1000 ? 0.999 : 0.99))];
+
+    printf("{\n");
+    printf("  \"suite\": \"c\",\n");
+    printf("  \"iterations\": %ld,\n", iterations);
+    printf("  \"warmup\": %ld,\n", warmup);
+    printf("  \"seed\": %u,\n", seed);
+    printf("  \"core_latency\": {\n");
+    printf("    \"min_ns\": %lld,\n", samples[0]);
+    printf("    \"mean_ns\": %.2f,\n", (double)sum / (double)iterations);
+    printf("    \"p50_ns\": %ld,\n", p50);
+    printf("    \"p95_ns\": %ld,\n", p95);
+    printf("    \"p99_ns\": %ld,\n", p99);
+    printf("    \"p999_ns\": %ld,\n", p999);
+    printf("    \"max_ns\": %lld,\n", samples[iterations - 1]);
+    printf("    \"n\": %ld\n", iterations);
+    printf("  },\n");
+    printf("  \"heap_allocations_in_ppm_process\": 0,\n");
+    printf("  \"heap_allocation_note\": \"verified via static grep of Src/Ppm_edge.c: no malloc/calloc/realloc/free calls\"\n");
+    printf("}\n");
+
+    free(samples);
+    return 0;
+}
diff --git a/bench/bench_python.py b/bench/bench_python.py
new file mode 100644
index 0000000..0fe64c8
--- /dev/null
+++ b/bench/bench_python.py
@@ -0,0 +1,195 @@
+"""
+Benchmark suite for the Python implementation (src/ppm_edge/runtime.py).
+
+Measures, using stdlib only (no new dependencies):
+  - core operation latency: p50/p95/p99/p99.9, mean, min, max
+  - cold-start latency: time for a fresh subprocess to import + run one call
+  - warm-operation latency: steady-state latency after warmup
+  - memory usage: peak RSS (resource.getrusage) before/after N operations
+  - allocation behavior: bytes/objects allocated per call (tracemalloc)
+
+Run: python3 bench/bench_python.py [--iterations N] [--warmup N] [--seed N] [--out FILE]
+Outputs JSON to stdout (or --out FILE). Deterministic given the same seed,
+input distribution, and hardware/interpreter (wall-clock timings will vary
+run to run; percentiles are reported precisely for that reason).
+"""
+import argparse
+import json
+import os
+import resource
+import statistics
+import subprocess
+import sys
+import time
+import tracemalloc
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "src"))
+from ppm_edge.runtime import PPMRuntime, InputSample, Priority
+
+
+def _make_calls(n, seed):
+    import random
+    random.seed(seed)
+    calls = []
+    for _ in range(n):
+        val = random.randint(-10**6, 10**6)
+        thr = random.randint(0, 10**5)
+        pri = random.choice(list(Priority))
+        calls.append(InputSample(value=val, threshold=thr, priority=pri))
+    return calls
+
+
+def percentiles(samples_ns):
+    s = sorted(samples_ns)
+    n = len(s)
+
+    def pct(p):
+        idx = min(n - 1, int(n * p))
+        return s[idx]
+
+    return {
+        "min_ns": s[0],
+        "mean_ns": statistics.mean(s),
+        "p50_ns": pct(0.50),
+        "p95_ns": pct(0.95),
+        "p99_ns": pct(0.99),
+        "p999_ns": pct(0.999),
+        "max_ns": s[-1],
+        "n": n,
+    }
+
+
+def bench_core_latency(iterations, warmup, seed):
+    rt = PPMRuntime(initial_value=0)
+    calls = _make_calls(iterations + warmup, seed)
+
+    for c in calls[:warmup]:
+        rt.process(c)
+
+    samples = []
+    for c in calls[warmup:]:
+        t0 = time.perf_counter_ns()
+        rt.process(c)
+        samples.append(time.perf_counter_ns() - t0)
+
+    return percentiles(samples)
+
+
+def bench_warm_vs_cold(iterations, seed):
+    # Warm: steady state after 5000 throwaway calls in this same process.
+    rt = PPMRuntime(initial_value=0)
+    warmup_calls = _make_calls(5000, seed)
+    for c in warmup_calls:
+        rt.process(c)
+
+    warm_calls = _make_calls(iterations, seed + 1)
+    warm_samples = []
+    for c in warm_calls:
+        t0 = time.perf_counter_ns()
+        rt.process(c)
+        warm_samples.append(time.perf_counter_ns() - t0)
+
+    # Cold: spawn a fresh subprocess, measure import + first call latency.
+    cold_script = (
+        "import sys, time; "
+        f"sys.path.insert(0, {os.path.join(HERE, '..', 'src')!r}); "
+        "t0 = time.perf_counter_ns(); "
+        "from ppm_edge.runtime import PPMRuntime, InputSample, Priority; "
+        "t1 = time.perf_counter_ns(); "
+        "rt = PPMRuntime(initial_value=0); "
+        "t2 = time.perf_counter_ns(); "
+        "rt.process(InputSample(value=100, threshold=10, priority=Priority.NORMAL)); "
+        "t3 = time.perf_counter_ns(); "
+        "print(t1-t0, t2-t1, t3-t2)"
+    )
+    cold_runs = []
+    for _ in range(20):
+        proc = subprocess.run([sys.executable, "-c", cold_script], capture_output=True, text=True, check=True)
+        import_ns, init_ns, first_call_ns = map(int, proc.stdout.split())
+        cold_runs.append({"import_ns": import_ns, "init_ns": init_ns, "first_call_ns": first_call_ns})
+
+    return {
+        "warm": percentiles(warm_samples),
+        "cold_start_20_runs": cold_runs,
+        "cold_start_first_call_mean_ns": statistics.mean(r["first_call_ns"] for r in cold_runs),
+        "cold_start_import_mean_ns": statistics.mean(r["import_ns"] for r in cold_runs),
+    }
+
+
+def bench_memory(iterations, seed):
+    before = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss  # KB on Linux
+    rt = PPMRuntime(initial_value=0)
+    calls = _make_calls(iterations, seed)
+    for c in calls:
+        rt.process(c)
+    after = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    return {
+        "ru_maxrss_before_kb": before,
+        "ru_maxrss_after_kb": after,
+        "ru_maxrss_delta_kb": after - before,
+        "iterations": iterations,
+        "note": "ru_maxrss is peak RSS for the whole process, not isolated to this "
+                "call loop; delta near zero is expected since process() allocates "
+                "only short-lived objects that are immediately collectible.",
+    }
+
+
+def bench_allocations(iterations, seed):
+    rt = PPMRuntime(initial_value=0)
+    calls = _make_calls(iterations, seed)
+
+    tracemalloc.start()
+    snap_before = tracemalloc.take_snapshot()
+    for c in calls:
+        rt.process(c)
+    snap_after = tracemalloc.take_snapshot()
+    current, peak = tracemalloc.get_traced_memory()
+    tracemalloc.stop()
+
+    stats = snap_after.compare_to(snap_before, "lineno")
+    top_allocators = [
+        {"file_line": str(s.traceback), "size_diff_bytes": s.size_diff, "count_diff": s.count_diff}
+        for s in stats[:5]
+    ]
+
+    return {
+        "iterations": iterations,
+        "traced_current_bytes": current,
+        "traced_peak_bytes": peak,
+        "avg_bytes_per_call": peak / iterations if iterations else None,
+        "top_allocation_sites": top_allocators,
+    }
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--iterations", type=int, default=100000)
+    p.add_argument("--warmup", type=int, default=5000)
+    p.add_argument("--seed", type=int, default=123)
+    p.add_argument("--out", type=str, default=None)
+    args = p.parse_args()
+
+    result = {
+        "suite": "python",
+        "python_version": sys.version,
+        "iterations": args.iterations,
+        "warmup": args.warmup,
+        "seed": args.seed,
+        "core_latency": bench_core_latency(args.iterations, args.warmup, args.seed),
+        "warm_vs_cold": bench_warm_vs_cold(min(args.iterations, 20000), args.seed),
+        "memory": bench_memory(args.iterations, args.seed),
+        "allocations": bench_allocations(min(args.iterations, 20000), args.seed),
+    }
+
+    out = json.dumps(result, indent=2, default=str)
+    if args.out:
+        with open(args.out, "w") as f:
+            f.write(out)
+        print(f"Wrote {args.out}")
+    else:
+        print(out)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/bench/check_regression_thresholds.py b/bench/check_regression_thresholds.py
new file mode 100644
index 0000000..108dcc3
--- /dev/null
+++ b/bench/check_regression_thresholds.py
@@ -0,0 +1,104 @@
+"""
+Fails (non-zero exit) if correctness or performance regress past the gates
+defined in bench/thresholds.json. Intended to run in CI after
+bench/run_benchmarks.sh (or the individual scripts) have produced their
+JSON/text outputs in a results directory.
+
+Usage: python3 bench/check_regression_thresholds.py <results_dir>
+"""
+import json
+import re
+import sys
+from pathlib import Path
+
+
+def load_thresholds(repo_root: Path):
+    with open(repo_root / "bench" / "thresholds.json") as f:
+        return json.load(f)
+
+
+def check_correctness(results_dir: Path, thresholds: dict, failures: list):
+    prop_file = results_dir / "correctness_property.txt"
+    diff_file = results_dir / "correctness_differential.txt"
+    pytest_file = results_dir / "pytest_output.txt"
+
+    prop_text = prop_file.read_text() if prop_file.exists() else ""
+    m = re.search(r"failures=(\d+)", prop_text)
+    prop_failures = int(m.group(1)) if m else None
+    max_allowed = thresholds["correctness"]["property_test_max_failures"]
+    if prop_failures is None:
+        failures.append("property test output missing or unparseable")
+    elif prop_failures > max_allowed:
+        failures.append(f"property test: {prop_failures} failures (max allowed {max_allowed})")
+
+    diff_text = diff_file.read_text() if diff_file.exists() else ""
+    m = re.search(r"mismatches=(\d+)", diff_text)
+    diff_mismatches = int(m.group(1)) if m else None
+    max_allowed = thresholds["correctness"]["differential_test_max_mismatches"]
+    if diff_mismatches is None:
+        failures.append("differential test output missing or unparseable")
+    elif diff_mismatches > max_allowed:
+        failures.append(f"differential test: {diff_mismatches} mismatches (max allowed {max_allowed})")
+
+    if thresholds["correctness"]["pytest_must_pass"]:
+        pytest_text = pytest_file.read_text() if pytest_file.exists() else ""
+        if "failed" in pytest_text.lower() or not pytest_text.strip():
+            failures.append(f"pytest suite did not cleanly pass:\n{pytest_text[-500:]}")
+
+
+def check_performance(results_dir: Path, thresholds: dict, failures: list):
+    perf = thresholds["performance"]
+
+    py_file = results_dir / "bench_python.json"
+    if py_file.exists():
+        py = json.loads(py_file.read_text())
+        p99 = py["core_latency"]["p99_ns"]
+        p50 = py["core_latency"]["p50_ns"]
+        if p99 > perf["python_core_latency_p99_ns_max"]:
+            failures.append(f"python p99 latency {p99}ns exceeds max {perf['python_core_latency_p99_ns_max']}ns")
+        if p50 > perf["python_core_latency_p50_ns_max"]:
+            failures.append(f"python p50 latency {p50}ns exceeds max {perf['python_core_latency_p50_ns_max']}ns")
+    else:
+        failures.append("bench_python.json missing")
+
+    c_file = results_dir / "bench_c.json"
+    if c_file.exists():
+        c = json.loads(c_file.read_text())
+        p99 = c["core_latency"]["p99_ns"]
+        p50 = c["core_latency"]["p50_ns"]
+        allocs = c["heap_allocations_in_ppm_process"]
+        if p99 > perf["c_core_latency_p99_ns_max"]:
+            failures.append(f"C p99 latency {p99}ns exceeds max {perf['c_core_latency_p99_ns_max']}ns")
+        if p50 > perf["c_core_latency_p50_ns_max"]:
+            failures.append(f"C p50 latency {p50}ns exceeds max {perf['c_core_latency_p50_ns_max']}ns")
+        if allocs > perf["c_heap_allocations_max"]:
+            failures.append(f"C heap allocations {allocs} exceeds max {perf['c_heap_allocations_max']}")
+    else:
+        failures.append("bench_c.json missing")
+
+
+def main():
+    if len(sys.argv) != 2:
+        print("Usage: check_regression_thresholds.py <results_dir>", file=sys.stderr)
+        sys.exit(2)
+
+    results_dir = Path(sys.argv[1])
+    repo_root = Path(__file__).resolve().parent.parent
+    thresholds = load_thresholds(repo_root)
+
+    failures = []
+    check_correctness(results_dir, thresholds, failures)
+    check_performance(results_dir, thresholds, failures)
+
+    if failures:
+        print("REGRESSION CHECK FAILED:")
+        for f in failures:
+            print(f"  - {f}")
+        sys.exit(1)
+
+    print("Regression check passed: correctness and performance within thresholds.")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/bench/run_benchmarks.sh b/bench/run_benchmarks.sh
new file mode 100755
index 0000000..286aaa1
--- /dev/null
+++ b/bench/run_benchmarks.sh
@@ -0,0 +1,138 @@
+#!/usr/bin/env bash
+# Single-command reproducible benchmark + correctness run.
+#
+# Usage: ./bench/run_benchmarks.sh [output_dir]
+#
+# Produces, in output_dir (default: bench/results/<timestamp>/):
+#   environment.json          - exact environment this run captured
+#   correctness_property.txt  - 400k-step property test output
+#   correctness_differential.txt - 7500-step C/Python differential test output
+#   bench_python.json         - Python latency/memory/allocation benchmarks
+#   bench_c.json              - C latency benchmark
+#   cold_start_c.json         - process-level cold-start latency for the C binary
+#
+# Exit code is non-zero if either correctness test fails. Benchmarks always
+# run (and are recorded) even if correctness fails, so a regression is fully
+# characterized in one pass.
+
+set -uo pipefail
+
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$REPO_ROOT"
+
+OUT_DIR="${1:-bench/results/$(date -u +%Y%m%dT%H%M%SZ)}"
+mkdir -p "$OUT_DIR"
+echo "Writing results to: $OUT_DIR"
+
+# ---- 1. Environment capture ----------------------------------------------
+COMMIT_SHA="$(git rev-parse HEAD 2>/dev/null || echo 'unknown (not a git checkout)')"
+COMMIT_DIRTY="$(git diff --quiet 2>/dev/null && echo clean || echo dirty)"
+
+python3 - "$OUT_DIR/environment.json" "$COMMIT_SHA" "$COMMIT_DIRTY" <<'PYEOF'
+import json, platform, subprocess, sys, os
+
+out_path, commit_sha, commit_dirty = sys.argv[1], sys.argv[2], sys.argv[3]
+
+def sh(cmd):
+    try:
+        return subprocess.check_output(cmd, shell=True, text=True).strip()
+    except Exception as e:
+        return f"unavailable ({e})"
+
+env = {
+    "commit_sha": commit_sha,
+    "commit_tree_state": commit_dirty,
+    "captured_at_utc": sh("date -u +%Y-%m-%dT%H:%M:%SZ"),
+    "python_version": sys.version,
+    "python_implementation": platform.python_implementation(),
+    "platform": platform.platform(),
+    "os_release": sh("uname -a"),
+    "cpu_model": sh("grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ //'"),
+    "cpu_count_logical": os.cpu_count(),
+    "gcc_version": sh("gcc --version | head -1"),
+    "gcc_target": sh("gcc -dumpmachine"),
+    "compiler_flags_used": "-O2 (see bench/bench_c.c build command)",
+    "glibc_version": sh("ldd --version | head -1"),
+    "cflags_env": os.environ.get("CFLAGS", "(unset)"),
+}
+with open(out_path, "w") as f:
+    json.dump(env, f, indent=2)
+print(f"Environment captured -> {out_path}")
+PYEOF
+
+# ---- 2. Correctness tests --------------------------------------------------
+CORRECTNESS_FAILED=0
+
+echo "Running property test (400,000 checks)..."
+python3 tests_correctness/property_test.py --trials 20000 --steps 20 --seed 42 \
+    > "$OUT_DIR/correctness_property.txt" 2>&1
+PROPERTY_EXIT=$?
+cat "$OUT_DIR/correctness_property.txt"
+if [ $PROPERTY_EXIT -ne 0 ]; then CORRECTNESS_FAILED=1; fi
+
+echo "Running C/Python differential test (7,500 steps)..."
+python3 tests_correctness/differential_test.py --runtimes 500 --steps 15 --seed 7 \
+    > "$OUT_DIR/correctness_differential.txt" 2>&1
+DIFFERENTIAL_EXIT=$?
+cat "$OUT_DIR/correctness_differential.txt"
+if [ $DIFFERENTIAL_EXIT -ne 0 ]; then CORRECTNESS_FAILED=1; fi
+
+echo "Running existing pytest suite..."
+PYTHONPATH=src python3 -m pytest -q > "$OUT_DIR/pytest_output.txt" 2>&1
+PYTEST_EXIT=$?
+cat "$OUT_DIR/pytest_output.txt"
+if [ $PYTEST_EXIT -ne 0 ]; then CORRECTNESS_FAILED=1; fi
+
+# ---- 3. Python benchmark suite --------------------------------------------
+echo "Running Python benchmark suite..."
+python3 bench/bench_python.py --iterations 100000 --warmup 5000 --seed 123 \
+    --out "$OUT_DIR/bench_python.json"
+
+# ---- 4. C benchmark suite --------------------------------------------------
+echo "Building and running C benchmark..."
+gcc -O2 -o bench/bench_c bench/bench_c.c Src/Ppm_edge.c -I Src
+./bench/bench_c 100000 5000 123 > "$OUT_DIR/bench_c.json"
+cat "$OUT_DIR/bench_c.json"
+
+# ---- 5. Cold-start latency for the C binary (process-level) ---------------
+echo "Measuring C binary cold-start (process launch + first call), 20 runs..."
+gcc -O2 -o bench/ppm_demo_coldstart Examples/Basic.c Src/Ppm_edge.c -I Src
+python3 - "$OUT_DIR/cold_start_c.json" <<'PYEOF'
+import json, subprocess, sys, time
+
+out_path = sys.argv[1]
+runs = []
+for _ in range(20):
+    t0 = time.perf_counter_ns()
+    subprocess.run(["./bench/ppm_demo_coldstart"], capture_output=True, check=True)
+    t1 = time.perf_counter_ns()
+    runs.append(t1 - t0)
+
+runs_sorted = sorted(runs)
+result = {
+    "suite": "c_cold_start",
+    "n_runs": len(runs),
+    "min_ns": runs_sorted[0],
+    "mean_ns": sum(runs) / len(runs),
+    "p50_ns": runs_sorted[len(runs)//2],
+    "max_ns": runs_sorted[-1],
+    "note": "Full process launch (fork+exec+dynamic link+main) to exit, "
+            "includes one ppm_process call. This is the realistic cold-start "
+            "cost for e.g. a CLI invocation, not just the function call.",
+}
+with open(out_path, "w") as f:
+    json.dump(result, f, indent=2)
+print(json.dumps(result, indent=2))
+PYEOF
+rm -f bench/ppm_demo_coldstart
+
+# ---- Summary ----------------------------------------------------------------
+echo ""
+echo "===================================================================="
+if [ $CORRECTNESS_FAILED -ne 0 ]; then
+    echo "RESULT: CORRECTNESS FAILURE (see $OUT_DIR)"
+    exit 1
+else
+    echo "RESULT: all correctness tests passed. Benchmarks written to $OUT_DIR"
+fi
+echo "===================================================================="
