+"""
+Property test: validates PPMRuntime.process() against the documented
+threshold/delta/confidence contract across randomized inputs.
+
+Run: python3 tests_correctness/property_test.py [--trials N] [--steps N] [--seed N]
+Exit code 0 = all invariants held. Non-zero = failure (mismatches printed).
+"""
+import argparse
+import sys
+import os
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
+from ppm_edge.runtime import PPMRuntime, InputSample, Priority
+
+
+def run(trials: int, steps: int, seed: int) -> int:
+    import random
+    random.seed(seed)
+    failures = 0
+    total_checks = 0
+
+    for i in range(trials):
+        init = random.randint(-10**6, 10**6)
+        rt = PPMRuntime(initial_value=init)
+        last = init
+        for step in range(steps):
+            val = random.randint(-10**6, 10**6)
+            thr = random.randint(0, 10**5)
+            pr = random.choice(list(Priority))
+            d = rt.process(InputSample(value=val, threshold=thr, priority=pr))
+
+            expected_delta = abs(val - last)
+            expected_protected = (expected_delta >= thr) or (pr == Priority.CRITICAL)
+            if expected_delta == 0:
+                expected_conf = 100
+            elif expected_delta < thr:
+                expected_conf = 75
+            else:
+                expected_conf = 50
+
+            total_checks += 1
+            ok = (
+                d.delta == expected_delta
+                and d.protected == expected_protected
+                and d.confidence == expected_conf
+            )
+            if not ok:
+                failures += 1
+                if failures <= 10:
+                    print(f"MISMATCH trial={i} step={step} val={val} thr={thr} pri={pr} "
+                          f"got={d} expected=(delta={expected_delta}, protected={expected_protected}, "
+                          f"confidence={expected_conf})")
+            last = val
+
+    print(f"property_test: trials={trials} steps_per_trial={steps} total_checks={total_checks} "
+          f"failures={failures}")
+    return 0 if failures == 0 else 1
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--trials", type=int, default=20000)
+    p.add_argument("--steps", type=int, default=20)
+    p.add_argument("--seed", type=int, default=42)
+    args = p.parse_args()
+    sys.exit(run(args.trials, args.steps, args.seed))
