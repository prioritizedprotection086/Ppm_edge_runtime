+"""
+Differential test: proves the C implementation (Src/Ppm_edge.c) and the
+Python implementation (src/ppm_edge/runtime.py) produce bit-identical
+output across randomized inputs.
+
+Run: python3 tests_correctness/differential_test.py [--runtimes N] [--steps N] [--seed N]
+Requires: gcc available on PATH (compiles the C harness on first run).
+Exit code 0 = C and Python agree on every step. Non-zero = mismatch found.
+"""
+import argparse
+import os
+import random
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "src"))
+from ppm_edge.runtime import PPMRuntime, InputSample, Priority
+
+HARNESS_SRC = os.path.join(HERE, "harness_c", "harness.c")
+HARNESS_BIN = os.path.join(HERE, "harness_c", "harness")
+PPM_EDGE_C = os.path.join(HERE, "..", "Src", "Ppm_edge.c")
+PPM_EDGE_INCLUDE = os.path.join(HERE, "..", "Src")
+
+
+def build_harness():
+    subprocess.run(
+        ["gcc", "-O2", "-o", HARNESS_BIN, HARNESS_SRC, PPM_EDGE_C, "-I", PPM_EDGE_INCLUDE],
+        check=True,
+    )
+
+
+def run(num_runtimes: int, steps: int, seed: int) -> int:
+    build_harness()
+    random.seed(seed)
+
+    stdin_lines = []
+    py_expected = []
+
+    for _ in range(num_runtimes):
+        init = random.randint(-10**6, 10**6)
+        stdin_lines.append(str(init))
+        stdin_lines.append(str(steps))
+        rt = PPMRuntime(initial_value=init)
+        for _s in range(steps):
+            val = random.randint(-10**6, 10**6)
+            thr = random.randint(0, 10**5)
+            pri = random.choice([0, 1, 2, 3])
+            stdin_lines.append(f"{val} {thr} {pri}")
+            d = rt.process(InputSample(value=val, threshold=thr, priority=Priority(pri)))
+            py_expected.append((d.delta, int(d.protected), d.confidence))
+
+    proc = subprocess.run(
+        [HARNESS_BIN], input="\n".join(stdin_lines), capture_output=True, text=True, check=True
+    )
+    c_lines = [l for l in proc.stdout.strip().split("\n") if l]
+
+    if len(c_lines) != len(py_expected):
+        print(f"FATAL: step count mismatch C={len(c_lines)} PY={len(py_expected)}")
+        return 1
+
+    mismatches = 0
+    for i, (line, (pd, pp, pc)) in enumerate(zip(c_lines, py_expected)):
+        cd, cp, cc = map(int, line.split(","))
+        if (cd, cp, cc) != (pd, pp, pc):
+            mismatches += 1
+            if mismatches <= 10:
+                print(f"MISMATCH step={i}: C=({cd},{cp},{cc}) PY=({pd},{pp},{pc})")
+
+    total = len(py_expected)
+    print(f"differential_test: runtimes={num_runtimes} steps_per_runtime={steps} "
+          f"total_steps={total} mismatches={mismatches}")
+    return 0 if mismatches == 0 else 1
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--runtimes", type=int, default=500)
+    p.add_argument("--steps", type=int, default=15)
+    p.add_argument("--seed", type=int, default=7)
+    args = p.parse_args()
+    sys.exit(run(args.runtimes, args.steps, args.seed))
