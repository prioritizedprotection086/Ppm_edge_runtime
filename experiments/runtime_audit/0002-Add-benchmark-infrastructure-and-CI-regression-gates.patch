@@ -0,0 +1,31 @@
+/* Differential-test harness: exposes ppm_process via stdin/stdout so it can
+ * be driven from Python and compared against the Python implementation.
+ * Input format (whitespace separated):
+ *   <initial_value> <n_steps> [<signal> <threshold> <priority>]... repeated per runtime
+ * Output: one CSV line per step: delta,protected,confidence
+ */
+#include <stdio.h>
+#include "../../Src/Ppm_edge.h"
+
+int main(void) {
+    int32_t init, val, thr;
+    int pri;
+    ppm_runtime_t rt;
+
+    while (scanf("%d", &init) == 1) {
+        ppm_init(&rt, init, 0);
+        int n;
+        if (scanf("%d", &n) != 1) break;
+        for (int i = 0; i < n; i++) {
+            if (scanf("%d %d %d", &val, &thr, &pri) != 3) return 1;
+            ppm_input_t in = {
+                .signal = val, .baseline = init, .threshold = thr,
+                .confidence = 0, .priority = (ppm_priority_t)pri
+            };
+            ppm_output_t out;
+            ppm_process(&rt, &in, &out);
+            printf("%u,%u,%u\n", out.delta, out.protected_mode, out.confidence);
+        }
+    }
+    return 0;
+}
